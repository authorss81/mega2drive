# Defense in depth — these should NEVER be committed, since GitHub Secrets
# are the only place your real credentials belong. This file just makes
# sure an accidental `git add .` locally can't leak them.

config.yaml
config_drive_source.yaml
credentials/
*.json
downloads/

# EXCEPTION: the run report. `*.json` above exists to keep credential files
# out of a public repo, but it also swallowed logs/last_run.json - which the
# dispatcher workflow reads to decide whether to chain another run. Ignored
# means never committed, so the dispatcher always saw "no run report" and
# never chained; the backlog only advanced on the 5-hourly cron. This file
# holds counters and a run id, never a credential, so it is safe to track.
!logs/last_run.json

# Python bytecode from local testing / compile checks
__pycache__/
*.pyc

# Probing tools are deleted and must never be recreated.
#
# A script that walks email_pattern across n=1..100 and authenticates will get
# the accounts locked: MEGA's fraud detection is not per-account as it first
# appears. Every base+{n}@gmail.com alias delivers to the SAME real mailbox, so
# 50 authentications against it in a few minutes reads as enumeration. That
# locked an account on 2026-09-29.
#
# Their names stay here as a permanent safety net: if one is ever written again,
# git ignores it by default rather than leaving it one `git add` from public.
probe_accounts.py
probe_passwords.py
probe-mega-accounts.yml


probe_passwords.py

