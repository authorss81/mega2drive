# =====================================================================
# config_drive_source.yaml — FILL THIS IN LOCALLY / AS GITHUB SECRETS,
# NEVER IN A CHAT
# =====================================================================
# Drive is the landing zone: upload new videos from your PC straight into
# one Drive folder (fastest single hop). This config drives the automation
# that fans them out to MEGA (real storage, spread across many
# capacity-capped accounts) and YouTube (backup), running headless.

# --- DRIVE SOURCE (the landing folder you upload new videos into) ---
drive_source:
  name: "drive-landing"
  client_secret_file: "credentials/client_secret_drive_source.json"
  token_file: "credentials/token_drive_source.json"
  folder_id: "REPLACE_ME"   # the Drive folder's ID (from its URL, after /folders/)

# --- ONLY these extensions are ever picked up from the Drive folder ---
allowed_extensions:
  - ".mkv"

# --- HOW MANY MEGA ACCOUNTS TO UPLOAD IN PARALLEL AT ONCE ---
# Each parallel worker = one isolated mega-cmd session = one account
# uploading independently. Higher = faster (up to your runner's total
# bandwidth ceiling), but more simultaneous connections. Start at 5 and
# increase once you've confirmed it's stable.
parallel_workers: 5

# --- MEGA DESTINATION ACCOUNTS (your real, permanent storage — 30 accounts) ---
# The script fills each account up to cap_gb before moving to the next
# (greedy bin-packing), tracked automatically via the manifest — you don't
# need to manually figure out which video goes where.
#
# starting_used_gb: if an account ISN'T empty when you start this pipeline
# (e.g. it already has other files on it from before, outside this
# pipeline's tracking), tell it how many GB are already used so it doesn't
# overfill past the real 20GB cap. Leave at 0 for a freshly created account.

# OPTIONAL: one password for every account that doesn't set its own.
# mega_destination_accounts_default_password: "your-shared-password"

mega_destination_accounts:
  # --- COMPACT FORM: generate many accounts from a pattern ---
  # {n} is replaced with the account number. Use `numbers` for a specific
  # list, or `count` (+ optional `start_at`) for a contiguous run.
  - email_pattern: "yourbase+{n}@gmail.com"
    numbers: [1, 2, 3, 4, 5, 45]        # or: count: 30   /   count: 30, start_at: 1
    password: "REPLACE_ME"               # applies to every account this block generates
    alias_prefix: "storage_"             # -> storage_1, storage_2, ... (visible in logs, not the email)
    enabled: true
    cap_gb: 20                           # copied onto every generated account
    starting_used_gb: 0
    remote_dir: "/"

  # --- EXPLICIT FORM: one entry per account, if you prefer listing them ---
  #  - email: "storage1@example.com"
  #    password: "REPLACE_ME"
  #    alias: "storage_1"     # shown in logs/manifest instead of the real email —
  #                           # important on a PUBLIC repo. Set it explicitly.
  #    enabled: true         # set false to permanently exclude a dead/deleted account
  #                           # from the capacity packer, instead of files getting
  #                           # routed to it every run and failing
  #    cap_gb: 20
  #    starting_used_gb: 0
  #    remote_dir: "/"
  #
  # Both forms can be mixed in the same list. Any extra key in a pattern
  # block (cap_gb, remote_dir, enabled, starting_used_gb) is copied onto each
  # account it generates, so you type it once.

# --- YOUTUBE CHANNELS (backup copies) ---
# Can reuse the same 5 channels/credentials already set up for the other
# pipeline — no need to duplicate the OAuth setup.
youtube_channels:
  - name: "channel1"
    client_secret_file: "credentials/client_secret_channel1.json"
    token_file: "credentials/token_channel1.json"
  - name: "channel2"
    client_secret_file: "credentials/client_secret_channel2.json"
    token_file: "credentials/token_channel2.json"
  # ... add up to 5 total

# --- UPLOAD SETTINGS ---
upload:
  privacy_status: "private"
  made_for_kids: false   # REQUIRED by YouTube on every upload (COPPA self-declaration) — set automatically
  category_id: "22"

# --- BEHAVIOR ---
behavior:
  delete_local_after_upload: true
  manifest_file: "manifest_drive_source.csv"   # separate tracking table from
                                                 # the other pipeline's manifest.csv
